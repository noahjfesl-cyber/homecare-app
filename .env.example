# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit real secrets.

# --- Database (Supabase project -> Settings -> Database -> Connection string) ---
# SERVER ONLY / SECRET — both contain the database password.
#
# DATABASE_URL: the POOLED connection (port 6543, "Transaction" mode,
# ?pgbouncer=true appended). Used by the running app at request time.
DATABASE_URL="postgresql://postgres.xxxxx:PASSWORD@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
#
# DIRECT_URL: the DIRECT connection (port 5432, no pooler). Used only when
# running migrations, which need a plain, non-pooled connection.
DIRECT_URL="postgresql://postgres.xxxxx:PASSWORD@aws-0-us-east-1.pooler.supabase.com:5432/postgres"

# --- Supabase Auth/Storage (Supabase project -> Settings -> API Keys) ---
# Use the current PUBLISHABLE / SECRET key pair, not the legacy anon /
# service_role keys (legacy keys are on a deprecation path).
#
# SAFE FOR CLIENT / PUBLIC — carries the same low privileges as the old
# anon key; Row-Level Security still applies to everything it does.
NEXT_PUBLIC_SUPABASE_URL="https://xxxxx.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxxxx"
#
# SERVER ONLY / SECRET. Never prefix with NEXT_PUBLIC_ and never send to
# the browser — it carries BYPASSRLS and skips every Row-Level Security
# policy. Not used until Step 3.
SUPABASE_SECRET_KEY="sb_secret_xxxxx"

# --- Misc ---
# Not a secret — just a build-time flag. This app stores private
# home/address data, so anonymous usage telemetry stays off by default.
NEXT_TELEMETRY_DISABLED=1
