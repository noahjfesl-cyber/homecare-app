# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit real secrets.

# --- Database (from your Supabase project) ---
# Project Settings -> Database -> Connection string
#
# DATABASE_URL: the POOLED connection (port 6543, "Transaction" mode,
# ?pgbouncer=true appended). Used by the running app.
DATABASE_URL="postgresql://postgres.xxxxx:PASSWORD@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
#
# DIRECT_URL: the DIRECT connection (port 5432, no pooler). Used only when
# running migrations, which need a plain, non-pooled connection.
DIRECT_URL="postgresql://postgres.xxxxx:PASSWORD@aws-0-us-east-1.pooler.supabase.com:5432/postgres"

# --- Supabase Auth/Storage (from Project Settings -> API) ---
# Safe to expose to the browser — this is the public anon key, not a secret.
NEXT_PUBLIC_SUPABASE_URL="https://xxxxx.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="xxxxx"
#
# SERVER-ONLY. Never prefix this with NEXT_PUBLIC_ — it bypasses Row-Level
# Security and must never reach the browser. Not used until Step 3.
SUPABASE_SERVICE_ROLE_KEY="xxxxx"

# --- Misc ---
# This app stores private home/address data — keep anonymous usage
# telemetry off by default.
NEXT_TELEMETRY_DISABLED=1
